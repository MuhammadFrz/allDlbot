# ========================================================
# All-In-One Telegram Media Downloader Bot Configuration
# ========================================================

# Telegram Bot API Credentials (from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here
TELEGRAM_DL_BOT_TOKEN=123456789:ABCDEF_your_bot_token_here

# Admin / Primary Chat ID
TELEGRAM_CHAT_ID=123456789

# (Optional) Instagram Session Cookie for authenticated scraping
INSTAGRAM_SESSIONID=

# (Optional) Remote Ubuntu VPS details for 1-click deployment (deploy/deploy.py)
IP_address=your_vps_ip
LOGIN=root
PASSWORD=your_vps_password
